DB_URL="postgres://postgres:postgres@localhost:5432?sslmode=disable"
DB_AUTO_CREATE="true"
DB_AUTO_MIGRATE="true"

RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# External base URL used for cookies and email links.
APP_BASE_URL="http://localhost:3000"

# Required: HS256 signing key for access tokens, at least 32 bytes.
JWT_SECRET="change-me-dev-only-32-bytes-minimum-secret"

# Optional: GitHub token. Raises the API rate limit and enables private repositories.
GITHUB_TOKEN=""
# Optional: GitHub API base URL.
GH_API_URL="https://api.github.com"

# Optional: OpenTelemetry traces
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
# OTEL_TRACES_SAMPLER="parentbased_traceidratio"
# OTEL_TRACES_SAMPLER_ARG="0.1"
